{
    "name": "agent-skills",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "setup": "bun run bin/skills-install.ts",
        "skills-install": "bun run bin/skills-install.ts",
        "skills-sync": "bun run bin/skills-sync.ts",
        "skills-lint": "bun run bin/skills-lint.ts",
        "build:css": "tailwindcss -i dashboard/css/input.css -o dashboard/static/build/css/generated.css",
        "build:dashboard": "bun run skills-sync && bun run build:css && zola --root dashboard build && pagefind --site dashboard/public",
        "serve:dashboard": "bun run build:dashboard && zola --root dashboard serve"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/js-yaml": "4.0.9",
        "@types/node": "25.6.0"
    },
    "peerDependencies": {
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@clack/prompts": "1.2.0",
        "fs-extra": "11.3.5",
        "glob": "13.0.6",
        "js-yaml": "4.1.1"
    }
}
