{
  "version": 4,
  "roles": {
    "researcher": {
      "targets": [
        {
          "providerInstanceId": "<provider-instance-id>",
          "model": "<model-id>",
          "options": {
            "<option-key>": "<option-value>"
          }
        }
      ]
    },
    "implementer": {
      "targets": [
        {
          "providerInstanceId": "<primary-provider-instance-id>",
          "model": "<model-id>",
          "options": {}
        },
        {
          "providerInstanceId": "<fallback-provider-instance-id>",
          "model": "<fallback-model-id>",
          "options": {
            "<option-key>": "<option-value>"
          }
        }
      ]
    },
    "reviewer": {
      "targets": [
        {
          "providerInstanceId": "<provider-instance-id>",
          "model": "<model-id>",
          "options": {
            "<option-key>": "<option-value>"
          }
        }
      ]
    }
  },
  "council": {
    "min_seats": 2,
    "seats": [
      {
        "name": "<anthropic-seat-name>",
        "family": "anthropic",
        "targets": [
          {
            "providerInstanceId": "<primary-provider-instance-id>",
            "model": "<anthropic-model-id>",
            "options": {
              "<option-key>": "<option-value>"
            }
          },
          {
            "providerInstanceId": "<fallback-provider-instance-id>",
            "model": "<anthropic-model-id>",
            "options": {
              "<option-key>": "<option-value>"
            }
          }
        ]
      },
      {
        "name": "<openai-seat-name>",
        "family": "openai",
        "targets": [
          {
            "providerInstanceId": "<provider-instance-id>",
            "model": "<openai-model-id>",
            "options": {
              "<option-key>": "<option-value>"
            }
          }
        ]
      },
      {
        "name": "<google-seat-name>",
        "family": "google",
        "targets": [
          {
            "providerInstanceId": "<provider-instance-id>",
            "model": "<google-model-id>",
            "options": {
              "<option-key>": "<option-value>"
            }
          }
        ]
      }
    ]
  },
  "workflow": {
    "max_parallel_issues": 2,
    "max_repair_rounds": 3,
    "repair_extension_rounds": 2,
    "max_council_rounds": 2,
    "max_infrastructure_recovery_attempts": 3
  }
}
